# =========================================================
# ZeroSec Backend Environment Variables
# Copy this file to .env and fill in your values
# =========================================================

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Database (default: SQLite for development)
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/zerosec_db

# JWT
JWT_SECRET_KEY=change-me-in-production

# =========================================================
# RAG Provider
# Set RAG_PROVIDER=external to use Groq + Qdrant instead of
# local Ollama + Chroma. Default is local (no API keys needed).
# =========================================================
RAG_PROVIDER=local     # "local" | "external"

# --- Groq API (required when RAG_PROVIDER=external) ---
# Sign up free at https://console.groq.com
# Free tier: 14,400 requests/day for llama-3.1-8b-instant
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=512

# --- Qdrant Cloud (required when RAG_PROVIDER=external) ---
# Sign up free at https://cloud.qdrant.io (1GB storage, no expiry)
# After creating a cluster, copy the URL and API key from the dashboard
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=zerosec_docs

# Similarity threshold for Qdrant retrieval (0-1, higher = stricter).
# Start at 0.30 and tune upward if results are too broad.
QDRANT_SIMILARITY_THRESHOLD=0.30

# --- Shared retrieval tuning (applies to both providers) ---
RAG_TOP_K=8
RAG_MAX_RESULTS=4

# =========================================================
# HuggingFace (for ML model downloads)
# =========================================================
HF_BERT_REPO=MrRobotcpp/zerosec-bert-injection-detector
HF_MODELS_REPO=MrRobotcpp/zerosec-ml-models
